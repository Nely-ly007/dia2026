<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">

    <ui:VisualElement name="root" style="
        width: 100%;
        height: 100%;
    ">

        <!-- PLACAR DE ROUNDS - topo centro -->
        <ui:VisualElement name="placar" style="
            position: absolute;
            top: 10px;
            left: 0;
            right: 0;
            align-items: center;
        ">
            <ui:VisualElement style="
                flex-direction: row;
                background-color: rgba(0,0,0,0.6);
                padding: 8px 24px;
                border-top-left-radius: 12px;
                border-top-right-radius: 12px;
                border-bottom-left-radius: 12px;
                border-bottom-right-radius: 12px;
                align-items: center;
            ">
                <ui:Label name="rounds-j1" text="●" style="font-size: 28px; color: rgb(100,180,255); margin-right: 16px;"/>
                <ui:Label text="ROUNDS" style="font-size: 14px; color: white;"/>
                <ui:Label name="rounds-j2" text="●" style="font-size: 28px; color: rgb(255,120,120); margin-left: 16px;"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- HUD JOGADOR 1 - canto inferior esquerdo -->
        <ui:VisualElement name="hud-j1" style="
            position: absolute;
            bottom: 20px;
            left: 20px;
            background-color: rgba(0,0,0,0.6);
            padding: 12px 16px;
            border-top-left-radius: 12px;
            border-top-right-radius: 12px;
            border-bottom-left-radius: 12px;
            border-bottom-right-radius: 12px;
        ">
            <ui:Label text="J1" style="font-size: 16px; color: rgb(100,180,255); -unity-font-style: bold; margin-bottom: 6px;"/>
            <ui:Label name="moedas-j1" text="🪙 0" style="font-size: 14px; color: rgb(255,220,50); margin-bottom: 8px;"/>
            <ui:Label text="AÇÃO" style="font-size: 11px; color: rgb(180,180,180); margin-bottom: 4px;"/>
            <ui:ProgressBar name="cooldown-j1" value="100" style="width: 140px;"/>
        </ui:VisualElement>

        <!-- HUD JOGADOR 2 - canto inferior direito -->
        <ui:VisualElement name="hud-j2" style="
            position: absolute;
            bottom: 20px;
            right: 20px;
            background-color: rgba(0,0,0,0.6);
            padding: 12px 16px;
            border-top-left-radius: 12px;
            border-top-right-radius: 12px;
            border-bottom-left-radius: 12px;
            border-bottom-right-radius: 12px;
            align-items: flex-end;
        ">
            <ui:Label text="J2" style="font-size: 16px; color: rgb(255,120,120); -unity-font-style: bold; margin-bottom: 6px;"/>
            <ui:Label name="moedas-j2" text="🪙 0" style="font-size: 14px; color: rgb(255,220,50); margin-bottom: 8px;"/>
            <ui:Label text="AÇÃO" style="font-size: 11px; color: rgb(180,180,180); margin-bottom: 4px;"/>
            <ui:ProgressBar name="cooldown-j2" value="100" style="width: 140px;"/>
        </ui:VisualElement>

    </ui:VisualElement>

</ui:UXML>