<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:uie="UnityEditor.UIElements"
         xsi:noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd"
         editor-extension-mode="False">

    <!--
        CoinHUD.uxml
        Interface da cena GUI que exibe a contagem de moedas.
        Referencie este arquivo no componente UIDocument do GameObject da cena GUI.
    -->

    <ui:VisualElement name="hud-root" style="
        position: absolute;
        top: 20px;
        left: 20px;
        background-color: rgba(0, 0, 0, 0.55);
        border-radius: 12px;
        padding: 10px 20px;
        flex-direction: row;
        align-items: center;
    ">
        <!-- Ícone de moeda (emoji como texto; substitua por um ícone real se preferir) -->
        <ui:Label name="coin-icon" text="🪙" style="
            font-size: 28px;
            margin-right: 8px;
        "/>

        <!-- Label principal — name="coin-label" é obrigatório para o CoinUIController -->
        <ui:Label name="coin-label" text="Moedas: 0" style="
            font-size: 24px;
            color: rgb(255, 220, 50);
            -unity-font-style: bold;
        "/>
    </ui:VisualElement>

</ui:UXML>
