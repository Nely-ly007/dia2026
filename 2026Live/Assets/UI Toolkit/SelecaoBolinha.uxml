<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">

    <ui:VisualElement name="root" style="
        flex-direction: row;
        justify-content: space-around;
        align-items: center;
        width: 100%;
        height: 100%;
        background-color: rgb(20, 20, 30);
    ">

        <!-- JOGADOR 1 -->
        <ui:VisualElement name="painel-j1" style="
            align-items: center;
            background-color: rgba(0,100,200,0.2);
            border-top-left-radius: 16px;
            border-top-right-radius: 16px;
            border-bottom-left-radius: 16px;
            border-bottom-right-radius: 16px;
            padding: 24px;
            width: 40%;
        ">
            <ui:Label text="JOGADOR 1" style="font-size: 22px; color: rgb(100,180,255); -unity-font-style: bold; margin-bottom: 12px;"/>

            <!-- Preview da bolinha: corpo + faixa -->
            <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 12px;">
                <ui:VisualElement name="icone-j1" style="
                    width: 70px; height: 70px;
                    border-top-left-radius: 35px;
                    border-top-right-radius: 35px;
                    border-bottom-left-radius: 35px;
                    border-bottom-right-radius: 35px;
                    background-color: rgb(255,255,255);
                "/>
                <ui:VisualElement name="icone-faixa-j1" style="
                    width: 70px; height: 14px;
                    background-color: rgb(200,200,200);
                    margin-left: -70px;
                    margin-top: 28px;
                "/>
            </ui:VisualElement>

            <!-- Bolinha -->
            <ui:Label name="nome-j1" text="Bolinha" style="font-size: 18px; color: white; -unity-font-style: bold;"/>
            <ui:VisualElement style="flex-direction: row; margin-top: 8px;">
                <ui:Button name="anterior-j1" text="&lt;" style="font-size: 18px; width: 36px;"/>
                <ui:Button name="proximo-j1"  text="&gt;" style="font-size: 18px; width: 36px;"/>
            </ui:VisualElement>

            <!-- Cor do corpo -->
            <ui:Label name="label-cor-corpo-j1" text="Corpo: Vermelho" style="font-size: 13px; color: rgb(200,200,200); margin-top: 10px;"/>
            <ui:VisualElement style="flex-direction: row; margin-top: 4px;">
                <ui:Button name="corpo-anterior-j1" text="&lt;" style="font-size: 18px; width: 36px;"/>
                <ui:Button name="corpo-proximo-j1"  text="&gt;" style="font-size: 18px; width: 36px;"/>
            </ui:VisualElement>

            <!-- Cor da faixa -->
            <ui:Label name="label-cor-faixa-j1" text="Faixa: Azul" style="font-size: 13px; color: rgb(200,200,200); margin-top: 10px;"/>
            <ui:VisualElement style="flex-direction: row; margin-top: 4px;">
                <ui:Button name="faixa-anterior-j1" text="&lt;" style="font-size: 18px; width: 36px;"/>
                <ui:Button name="faixa-proximo-j1"  text="&gt;" style="font-size: 18px; width: 36px;"/>
            </ui:VisualElement>

            <ui:Button name="confirmar-j1" text="Confirmar" style="margin-top: 14px; font-size: 16px; padding: 8px 24px;"/>
        </ui:VisualElement>

        <!-- CENTRO -->
        <ui:VisualElement style="align-items: center;">
            <ui:Label text="VS" style="font-size: 48px; color: rgb(255,200,50); -unity-font-style: bold;"/>
            <ui:Label name="aviso" text="" style="font-size: 13px; color: rgb(255,150,100); margin-top: 16px; white-space: normal; max-width: 160px;"/>
        </ui:VisualElement>

        <!-- JOGADOR 2 -->
        <ui:VisualElement name="painel-j2" style="
            align-items: center;
            background-color: rgba(200,50,50,0.2);
            border-top-left-radius: 16px;
            border-top-right-radius: 16px;
            border-bottom-left-radius: 16px;
            border-bottom-right-radius: 16px;
            padding: 24px;
            width: 40%;
        ">
            <ui:Label text="JOGADOR 2" style="font-size: 22px; color: rgb(255,120,120); -unity-font-style: bold; margin-bottom: 12px;"/>

            <!-- Preview da bolinha: corpo + faixa -->
            <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 12px;">
                <ui:VisualElement name="icone-j2" style="
                    width: 70px; height: 70px;
                    border-top-left-radius: 35px;
                    border-top-right-radius: 35px;
                    border-bottom-left-radius: 35px;
                    border-bottom-right-radius: 35px;
                    background-color: rgb(255,255,255);
                "/>
                <ui:VisualElement name="icone-faixa-j2" style="
                    width: 70px; height: 14px;
                    background-color: rgb(200,200,200);
                    margin-left: -70px;
                    margin-top: 28px;
                "/>
            </ui:VisualElement>

            <!-- Bolinha -->
            <ui:Label name="nome-j2" text="Bolinha" style="font-size: 18px; color: white; -unity-font-style: bold;"/>
            <ui:VisualElement style="flex-direction: row; margin-top: 8px;">
                <ui:Button name="anterior-j2" text="&lt;" style="font-size: 18px; width: 36px;"/>
                <ui:Button name="proximo-j2"  text="&gt;" style="font-size: 18px; width: 36px;"/>
            </ui:VisualElement>

            <!-- Cor do corpo -->
            <ui:Label name="label-cor-corpo-j2" text="Corpo: Verde" style="font-size: 13px; color: rgb(200,200,200); margin-top: 10px;"/>
            <ui:VisualElement style="flex-direction: row; margin-top: 4px;">
                <ui:Button name="corpo-anterior-j2" text="&lt;" style="font-size: 18px; width: 36px;"/>
                <ui:Button name="corpo-proximo-j2"  text="&gt;" style="font-size: 18px; width: 36px;"/>
            </ui:VisualElement>

            <!-- Cor da faixa -->
            <ui:Label name="label-cor-faixa-j2" text="Faixa: Amarelo" style="font-size: 13px; color: rgb(200,200,200); margin-top: 10px;"/>
            <ui:VisualElement style="flex-direction: row; margin-top: 4px;">
                <ui:Button name="faixa-anterior-j2" text="&lt;" style="font-size: 18px; width: 36px;"/>
                <ui:Button name="faixa-proximo-j2"  text="&gt;" style="font-size: 18px; width: 36px;"/>
            </ui:VisualElement>

            <ui:Button name="confirmar-j2" text="Confirmar" style="margin-top: 14px; font-size: 16px; padding: 8px 24px;"/>
        </ui:VisualElement>

    </ui:VisualElement>

</ui:UXML>