<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">

    <ui:VisualElement name="root" style="
        width: 100%;
        height: 100%;
        align-items: center;
        justify-content: center;
        background-color: rgb(20, 20, 30);
    ">

        <ui:Label text="🏆" style="font-size: 72px; margin-bottom: 16px;"/>

        <ui:Label name="label-vencedor" text="Jogador X venceu!" style="
            font-size: 36px;
            color: rgb(255,200,50);
            -unity-font-style: bold;
            margin-bottom: 12px;
        "/>

        <ui:Label name="label-bolinha" text="Bolinha: ???" style="
            font-size: 22px;
            color: rgb(200,200,200);
            margin-bottom: 40px;
        "/>

        <ui:Button name="btn-voltar" text="Jogar Novamente" style="
            font-size: 18px;
            padding: 12px 32px;
        "/>

    </ui:VisualElement>

</ui:UXML>